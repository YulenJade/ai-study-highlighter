APP_ENV=production
LIBRARY_USERS={"alice":"REPLACE_WITH_SALT_AND_SCRYPT_HASH"}
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
S3_BUCKET=private-study-books
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
AWS_DEFAULT_REGION=us-east-1
# AWS: omit endpoint. R2: use account-specific HTTPS S3 API endpoint, region auto.
# S3_ENDPOINT_URL=https://ACCOUNT.r2.cloudflarestorage.com
MAX_BOOK_MB=100
USER_QUOTA_MB=1024
USER_BOOK_LIMIT=100
